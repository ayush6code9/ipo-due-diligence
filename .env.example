# Copy this file to .env and fill in real values locally.
# Never commit the actual .env file.

# ---- App ----
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db

# ---- File uploads ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Vector store / embeddings ----
VECTOR_STORE_DIR=./data/vector_store
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ---- Semantic retrieval (Phase 6) ----
RETRIEVAL_TOP_K_DEFAULT=5
RETRIEVAL_TOP_K_MAX=10
# Cosine similarity threshold below which a chunk is considered not
# relevant enough to return. Starting point — tune based on real testing.
RETRIEVAL_RELEVANCE_THRESHOLD=0.2
RETRIEVAL_MAX_QUERY_LENGTH=500

# ---- LLM provider (Phase 8 — AI Summary & Chat) ----
# Get a free API key from https://aistudio.google.com/apikey
# Leave blank to use the deterministic template fallback (the platform
# still works without it, just without AI-generated summaries and chat).
GEMINI_API_KEY=

# ---- Other external API credentials (future) ----
# MARKET_DATA_API_KEY=

# ---- IPO Search (live search feature) ----
# Cache TTL for external IPO search results (hours)
IPO_SEARCH_CACHE_TTL_HOURS=6
# HTTP request timeout for external IPO lookups (seconds)
IPO_SEARCH_REQUEST_TIMEOUT=15
